{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.2.2",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://github.com/iArtem88/rutracker-games",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://ibb.co/*",
    "https://ibb.co.com/*",
    "https://postimg.cc/*"
  ],
  "optional_host_permissions": [
    "https://store.steampowered.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "ui/settings.html?popup",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "ui/settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://rutracker.org/forum/viewforum.php*",
        "https://rutracker.org/forum/tracker.php*",
        "https://rutracker.net/forum/viewforum.php*",
        "https://rutracker.net/forum/tracker.php*",
        "https://rutracker.nl/forum/viewforum.php*",
        "https://rutracker.nl/forum/tracker.php*"
      ],
      "js": [
        "lib/i18n.js",
        "locales/en.js",
        "locales/uk.js",
        "locales/ru.js",
        "locales/de.js",
        "locales/fr.js",
        "locales/es.js",
        "locales/it.js",
        "locales/pl.js",
        "locales/pt.js",
        "locales/ja.js",
        "lib/settings.js",
        "content/registry.js",
        "lib/badges.js",
        "content/games.js",
        "sections/switch.js",
        "sections/playstation.js",
        "sections/consoles.js",
        "sections/windows.js",
        "sections/mac.js",
        "sections/linux.js",
        "sections/mobile.js",
        "sections/addons.js",
        "content/viewer.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://rutracker.org/forum/viewtopic.php*",
        "https://rutracker.net/forum/viewtopic.php*",
        "https://rutracker.nl/forum/viewtopic.php*"
      ],
      "js": [
        "lib/i18n.js",
        "locales/en.js",
        "locales/uk.js",
        "locales/ru.js",
        "locales/de.js",
        "locales/fr.js",
        "locales/es.js",
        "locales/it.js",
        "locales/pl.js",
        "locales/pt.js",
        "locales/ja.js",
        "lib/settings.js",
        "content/registry.js",
        "lib/badges.js",
        "content/games.js",
        "sections/switch.js",
        "sections/playstation.js",
        "sections/consoles.js",
        "sections/windows.js",
        "sections/mac.js",
        "sections/linux.js",
        "sections/mobile.js",
        "sections/addons.js",
        "content/viewer.js",
        "content/topic.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.fastpic.org/view/*",
        "*://*.fastpic.ru/view/*"
      ],
      "js": [
        "content/fastpic.js"
      ],
      "all_frames": true,
      "run_at": "document_end"
    }
  ]
}
